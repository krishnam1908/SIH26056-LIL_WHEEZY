# Airfare Index / Flight scraper unified backend
# Copy this file to .env and adjust values as needed. Never commit .env.

# HTTP port for the server (serves the frontend + API)
PORT=5000

# MongoDB connection string.
# IMPORTANT: this is the SAME database the scraper writes to (flight_fares).
MONGODB_URI=mongodb://localhost:27017/flight_fares
NODE_ENV=development

# Enable MongoDB persistence for the scrape pipeline so scraped fares are
# stored in the fares collection (upsert-by-dedupeKey).
MONGO_WRITE_ENABLED=true

# JSON export (default persistence layer alongside MongoDB).
# Single shared output directory for all scraped/exported artifacts
# (fares-<date>.jsonl, akasa-network.json, dgca-<month>.json).
JSON_EXPORT_ENABLED=true
JSON_EXPORT_DIR=./output

# Scraper timing / retry
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=2000
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_DELAY=1000

# Akasa Air (real fare adapter)
AKASA_BASE_URL=https://prod-bl.qp.akasaair.com
AKASA_DEVICE_TYPE=WEB
AKASA_BOOKING_TYPE=BOOKING
AKASA_USER_TYPE=GUEST
AKASA_CHANNEL=WEB
AKASA_CURRENCY=INR
AKASA_MAX_CONNECTIONS=8

# DGCA monthly air-traffic statistics (airline-level, ~30-day window)
DGCA_REPORT_PERIOD=2026-04
# DGCA_REPORT_URL=   # optional override for months whose S3 file name differs

# Outlier detection rules
OUTLIER_MIN_FARE=100
OUTLIER_MAX_FARE=100000
OUTLIER_COMPONENT_MISMATCH_TOLERANCE=0.2
OUTLIER_MIN_MISMATCH_ABS=100

# Scheduler
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=info

# CORS: '*' allows any origin. Frontend is served same-origin by default.
CORS_ORIGIN=*
