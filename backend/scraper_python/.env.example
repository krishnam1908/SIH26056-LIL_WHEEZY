# Server (optional API placeholder; scraping pipeline is JSON-first).
PORT=5000
MONGODB_URI=mongodb://localhost:27017/flight_fares
NODE_ENV=development

# Scraper timing / retry
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=2000
SCRAPER_CONCURRENCY=2
SCRAPER_REQUEST_DELAY=1000

# Akasa Air (real fare adapter)
AKASA_BASE_URL=https://prod-bl.qp.akasaair.com
AKASA_DEVICE_TYPE=WEB
AKASA_BOOKING_TYPE=BOOKING
AKASA_USER_TYPE=GUEST
AKASA_CHANNEL=WEB
AKASA_CURRENCY=INR
AKASA_MAX_CONNECTIONS=8

# Akasa full-network sweep pacing / retry (optional)
# AKASA_NETWORK_DELAY_MS=300   # pause between grid requests
# AKASA_NETWORK_BACKOFF_MS=1000 # backoff base for transient grid failures

# DGCA monthly air-traffic statistics (airline-level, ~30-day window)
DGCA_REPORT_PERIOD=2026-04
# DGCA_REPORT_URL=   # optional override for months whose S3 file name differs

# Outlier detection rules
OUTLIER_MIN_FARE=100
OUTLIER_MAX_FARE=100000
OUTLIER_COMPONENT_MISMATCH_TOLERANCE=0.2
OUTLIER_MIN_MISMATCH_ABS=100

# JSON store (default persistence layer)
#   fares:     JSON_EXPORT_DIR/fares-YYYY-MM-DD.jsonl (one fare per line)
#   DGCA stats: JSON_EXPORT_DIR/dgca-YYYY-MM.json     (one doc per period)
JSON_EXPORT_ENABLED=true
JSON_EXPORT_DIR=./output

# MongoDB persistence (OPT-IN; NOT implemented in this Python port). Retained
# so .env files are shared with the JS project without breaking config load.
MONGO_WRITE_ENABLED=false

# Scheduler
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=info