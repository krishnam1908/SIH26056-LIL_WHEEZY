{
  "name": "airfare-index",
  "version": "1.0.0",
  "description": "Airfare Price Index - unified web app (vanilla frontend + Express API + flight-fare scraper + MongoDB)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "seed": "node backend/scripts/seedConfig.js",
    "scrape": "python -m backend.scraper_python",
    "scrape:akasa": "python -m backend.scraper_python --origin DEL --destination BOM --date 2026-10-15 --source akasa",
    "scrape:indigo": "python -m backend.scraper_python --origin DEL --destination BOM --date 2026-10-15 --source indigo",
    "scrape:airindia": "python -m backend.scraper_python --origin DEL --destination BOM --date 2026-10-15 --source airindia",
    "scrape:spicejet": "python -m backend.scraper_python --origin DEL --destination BOM --date 2026-10-15 --source spicejet",
    "scrape:airindiaexpress": "python -m backend.scraper_python --origin DEL --destination BOM --date 2026-10-15 --source airindiaexpress",
    "test": "node --test"
  },
  "keywords": [
    "airfare",
    "index",
    "flights",
    "fares",
    "scraper",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
